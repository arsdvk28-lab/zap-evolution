{
  "name": "singularity-walker",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.zap.singularity",
    "productName": "Singularity Walker",
    "directories": {
      "output": "dist_prod"
    },
    "win": {
      "target": "portable"
    },
    "extraResources": [
      {
        "from": "resources/bin/server_win.exe",
        "to": "bin/server_win.exe"
      }
    ],
    "files": [
      "main.js",
      "index.html"
    ]
  }
}